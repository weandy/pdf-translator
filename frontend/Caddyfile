{
	admin off
	servers {
		trusted_proxies static {$PDFTR_WEB_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# 监听地址与后端地址可用环境变量覆盖（主机网络模式见 deploy/docker-compose.hostnet.yml）
{$PDFTR_LISTEN::80} {
	encode zstd gzip

	# 旧管理网页入口不再回退到 SPA，避免误显示登录页或应用壳
	@legacy_admin path /admin /admin/*
	handle @legacy_admin {
		respond 404
	}

	# 接口转发给后端（默认是同一 Compose 网络里的服务 app）
	handle /api/* {
		reverse_proxy {$PDFTR_UPSTREAM:app:8000} {
			# SSE 进度推送不缓冲
			flush_interval -1
			# 后端重启（部署新版本）的几秒内先等它恢复，不立即报错
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# 前端不加载任何第三方资源；KaTeX 需要内联样式，pdf.js 需要 blob worker
	@admin_pages path {$PDFTR_ADMIN_PATH:/weandy} {$PDFTR_ADMIN_PATH:/weandy}/*
	header @admin_pages Cache-Control "no-store"

	header {
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# 部署到公网时建议开启访问密码：生成哈希 `caddy hash-password`，去掉下面三行的注释并替换
	# basic_auth {
	# 	admin <bcrypt 哈希>
	# }
}

# 轻量模式：只起后端 app 和前端 web，本地不跑任何模型（docs/01-tech-stack.md §6）
# 启动：在仓库根目录执行  docker compose -f deploy/docker-compose.yml up -d --build
