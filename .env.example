# 复制为 .env 后按需填写；不填也能启动，用户可在网页设置里填写自己的 Key（只保存在浏览器）。
# .env 已在 .gitignore 中，不会被提交。

# 网页访问端口
PDFTR_PORT=18765

# 部署者共享的翻译服务（可选）。用户在浏览器里填写的 Key 优先。
PDFTR_LLM_BASE_URL=https://api.deepseek.com
PDFTR_LLM_MODEL=deepseek-flash
PDFTR_LLM_API_KEY=
# 共享 Key 所用的接口协议：openai（OpenAI 兼容）或 anthropic（Anthropic Messages）
# 共享 Key 只会发往上面这个地址与协议；用户在设置里改了地址或协议，就必须填自己的 Key
PDFTR_LLM_PROTOCOL=openai

# 部署者共享的 MinerU 精准解析 API Token（可选），在 https://mineru.net/apiManage 创建。
# 配置后用户只需填写翻译 API Key；个人 MinerU Token 优先。不要使用网页登录 Cookie/JWT。
# 官网当前 Token 有效期 90 天，到期需创建新 Token 并更新此项、重建 app 容器。
PDFTR_MINERU_API_TOKEN=

# 发往 MinerU 的代理（可选）：服务器到国内线路差、上传很慢时，经一台线路好的机器转发。
# 支持 socks5h://用户:密码@主机:端口、http://主机:端口；只影响 MinerU，翻译服务仍直连
PDFTR_MINERU_PROXY=

# 百度 PaddleOCR-VL：后端保留了适配器（任务选项 parser=paddleocr-vl），但解析较慢，网页界面不开放
# 部署者共享的星河社区 Token（可选）与代理（可选）
PDFTR_PADDLE_TOKEN=
PDFTR_PADDLE_PROXY=

# 上传限制
PDFTR_MAX_UPLOAD_MB=200
PDFTR_MAX_PAGES=200

# 每个任务同时发给翻译服务的请求数；0 = 按服务商自动（DeepSeek 4 路、本机模型 1 路、其他 2 路）
PDFTR_LLM_CONCURRENCY=0

# 论文术语库来源（逗号分隔，排在前面的优先；留空不用术语库）。
# 机器之心术语库 aitd 为 CC BY-NC-SA 4.0，不可商用；商业部署请去掉 aitd
PDFTR_GLOSSARY_SOURCES=aitd,d2l,ml-technical-term,ais-vocab,gist,computerese

# 公开部署时的保护（默认值适合 2 核 2 GB）
# 同时排队的任务上限；任务文件与译文缓存保留天数（0 表示不自动清理）；磁盘剩余低于该值（MB）时拒绝上传
# 同时上传、解析的任务数（主要在等云端）与同时翻译的任务数（一篇接一篇，每篇内部并发见 PDFTR_LLM_CONCURRENCY）
PDFTR_MAX_CONCURRENT_JOBS=4
PDFTR_MAX_CONCURRENT_TRANSLATIONS=1
PDFTR_MAX_QUEUED_JOBS=10
# 原文与译文在服务器上保留的小时数，到期自动删除（0 表示不自动删除）
PDFTR_RETENTION_HOURS=24
PDFTR_MIN_FREE_DISK_MB=1024

# 管理入口默认为 /weandy/login，可通过 PDFTR_ADMIN_PATH 改成单一路径段。
# 默认关闭；哈希使用 backend/scripts/hash_admin_password.py 交互生成。
# 哈希包含 $，写入 .env 时请用单引号包裹整值，避免 Compose 做变量插值。
PDFTR_ADMIN_PASSWORD_HASH=
PDFTR_ADMIN_ORIGIN=
PDFTR_ADMIN_PATH=/weandy
# 管理会话有效期（天），范围 1～30，默认 30 天；不会自动滑动续期。
PDFTR_ADMIN_SESSION_DAYS=30
# 标题、提交IP、时间、页数和状态长期留存；须先配置管理、可信代理和上传告知。
PDFTR_SUBMISSION_AUDIT_ENABLED=false
# FastAPI 的可信代理 CIDR，逗号分隔；不要填写 0.0.0.0/0、::/0 或所有私网。
PDFTR_TRUSTED_PROXY_CIDRS=
# Caddy 信任的宿主机反代来源，空格分隔；核对实际 Docker 网关后再设置。
PDFTR_WEB_TRUSTED_PROXIES=127.0.0.1/32
