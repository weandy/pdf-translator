# 复制为 .env 后按需填写；不填也能启动，用户可在网页设置里填写自己的 Key（只保存在浏览器）。
# .env 已在 .gitignore 中，不会被提交。

# 网页访问端口
PDFTR_PORT=8080

# 部署者共享的翻译服务（可选）。用户在浏览器里填写的 Key 优先。
PDFTR_LLM_BASE_URL=https://api.deepseek.com
PDFTR_LLM_MODEL=deepseek-flash
PDFTR_LLM_API_KEY=

# 部署者共享的 MinerU 精准解析 Token（可选），在 https://mineru.net 免费申请
PDFTR_MINERU_API_TOKEN=

# 上传限制
PDFTR_MAX_UPLOAD_MB=200
PDFTR_MAX_PAGES=200
